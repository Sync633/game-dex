{
  "openapi": "3.0.0",
  "info": {
    "title": "GameDex API",
    "version": "1.0.0",
    "description": "API RESTful para cadastrar jogos e acompanhar quais já foram zerados."
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual da API"
    }
  ],
  "tags": [
    {
      "name": "Games",
      "description": "Gerenciamento do catálogo de jogos."
    }
  ],
  "paths": {
    "/games": {
      "get": {
        "summary": "Listar jogos",
        "description": "Retorna todos os jogos cadastrados. Quando não existem registros, retorna uma lista vazia.",
        "tags": ["Games"],
        "responses": {
          "200": {
            "description": "Lista de jogos retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Game"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "titulo": "Ori and the Blind Forest",
                    "desenvolvedora": "Moon Studios",
                    "plataforma": "PC",
                    "genero": "Metroidvania",
                    "anoLancamento": 2015,
                    "zerado": false,
                    "createdAt": "2026-09-27T20:00:00.000Z",
                    "updatedAt": "2026-09-27T20:00:00.000Z"
                  }
                ]
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      },
      "post": {
        "summary": "Cadastrar jogo",
        "description": "Cadastra um jogo. Todos os seis campos são obrigatórios e o título deve ser único. Espaços nas extremidades dos textos são removidos.",
        "tags": ["Games"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Jogo cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DadosInvalidos"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    },
    "/games/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador do jogo, informado somente com dígitos.",
          "schema": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          },
          "example": 1
        }
      ],
      "get": {
        "summary": "Buscar jogo por ID",
        "description": "Retorna os dados do jogo correspondente ao ID informado.",
        "tags": ["Games"],
        "responses": {
          "200": {
            "description": "Jogo encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/IdInvalido"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      },
      "put": {
        "summary": "Atualizar jogo",
        "description": "Atualiza somente os campos enviados, mantendo os demais valores. O título não pode pertencer a outro jogo. Um objeto vazio retorna o registro sem alterações. ID e campos de auditoria não são editáveis.",
        "tags": ["Games"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGameDTO"
              },
              "example": {
                "zerado": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jogo atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                },
                "example": {
                  "id": 1,
                  "titulo": "Ori and the Blind Forest",
                  "desenvolvedora": "Moon Studios",
                  "plataforma": "PC",
                  "genero": "Metroidvania",
                  "anoLancamento": 2015,
                  "zerado": true,
                  "createdAt": "2026-09-27T20:00:00.000Z",
                  "updatedAt": "2026-09-27T20:10:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DadosInvalidos"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      },
      "delete": {
        "summary": "Excluir jogo",
        "description": "Remove permanentemente o jogo correspondente ao ID informado.",
        "tags": ["Games"],
        "responses": {
          "204": {
            "description": "Jogo excluído com sucesso. Resposta sem corpo."
          },
          "400": {
            "$ref": "#/components/responses/IdInvalido"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Game": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true,
            "example": 1
          },
          "titulo": {
            "type": "string",
            "example": "Ori and the Blind Forest"
          },
          "desenvolvedora": {
            "type": "string",
            "example": "Moon Studios"
          },
          "plataforma": {
            "type": "string",
            "example": "PC"
          },
          "genero": {
            "type": "string",
            "example": "Metroidvania"
          },
          "anoLancamento": {
            "type": "integer",
            "example": 2015
          },
          "zerado": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-27T20:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true,
            "example": "2026-09-27T20:00:00.000Z"
          }
        }
      },
      "CreateGameDTO": {
        "type": "object",
        "required": [
          "titulo",
          "desenvolvedora",
          "plataforma",
          "genero",
          "anoLancamento",
          "zerado"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "description": "Título único, com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "Ori and the Blind Forest"
          },
          "desenvolvedora": {
            "type": "string",
            "description": "Nome da desenvolvedora, com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "Moon Studios"
          },
          "plataforma": {
            "type": "string",
            "description": "Plataforma do jogo, com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "PC"
          },
          "genero": {
            "type": "string",
            "description": "Gênero do jogo, com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "Metroidvania"
          },
          "anoLancamento": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "example": 2015
          },
          "zerado": {
            "type": "boolean",
            "description": "Indica se o jogo já foi concluído.",
            "example": false
          }
        }
      },
      "UpdateGameDTO": {
        "type": "object",
        "description": "Todos os campos são opcionais. Quando enviados, seguem as mesmas validações do cadastro.",
        "properties": {
          "titulo": {
            "type": "string",
            "description": "Título único, com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "Ori and the Blind Forest"
          },
          "desenvolvedora": {
            "type": "string",
            "description": "Texto com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "Moon Studios"
          },
          "plataforma": {
            "type": "string",
            "description": "Texto com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "PC"
          },
          "genero": {
            "type": "string",
            "description": "Texto com 1 a 255 caracteres após remover espaços nas extremidades.",
            "example": "Metroidvania"
          },
          "anoLancamento": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999,
            "example": 2015
          },
          "zerado": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Erro": {
        "type": "object",
        "required": ["mensagem"],
        "properties": {
          "mensagem": {
            "type": "string",
            "example": "Jogo não encontrado."
          }
        }
      }
    },
    "responses": {
      "DadosInvalidos": {
        "description": "Corpo inválido, campo obrigatório ausente no cadastro, valor inválido, título duplicado ou ID inválido na atualização.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "examples": {
              "campoInvalido": {
                "value": {
                  "mensagem": "O campo zerado deve ser true ou false."
                }
              },
              "tituloDuplicado": {
                "value": {
                  "mensagem": "Já existe um jogo cadastrado com esse título."
                }
              }
            }
          }
        }
      },
      "IdInvalido": {
        "description": "O ID informado é inválido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "mensagem": "O ID informado deve ser um inteiro positivo válido."
            }
          }
        }
      },
      "NaoEncontrado": {
        "description": "Não existe jogo com o ID informado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "mensagem": "Jogo não encontrado."
            }
          }
        }
      },
      "ErroInterno": {
        "description": "Falha interna ao executar a operação. A mensagem varia conforme a operação.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "mensagem": "Erro ao buscar jogo."
            }
          }
        }
      }
    }
  }
}